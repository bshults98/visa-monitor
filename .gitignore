# runtime state / analytics output at the repo root (regenerated, never
# committed to main). Leading slashes anchor these to the root so that the
# hosted runner's persist/ tree is NOT excluded by the same patterns.
/data/
/site/
/state.json
/monitor.log
*.log

# secrets
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.venv/
venv/

# test scratch
loop_*.txt
a.txt
a_err.txt
b.txt
b_err.txt
final_out.txt
final_err.txt

# unrelated card data dropped in this folder by another project - never commit
combinations_1821.txt
more cards.txt
sample_cards.txt
candidates_*.txt
*.cards.txt
